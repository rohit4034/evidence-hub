# Core
PUBLIC_APP_URL=https://evidence.shiptek.space
JWT_SECRET=replace-with-a-long-random-secret
DEFAULT_DATA_USE_POLICY=customer_private
DATA_RETENTION_DAYS=365

# Storage
POSTGRES_URL=postgresql://evidence:evidence@postgres:5432/evidence_hub
REDIS_URL=redis://redis:6379/0
FILE_STORAGE_PATH=/data/uploads
REPORT_STORAGE_PATH=/data/reports
EVAL_STORAGE_PATH=/data/evals

# AI
NVIDIA_API_KEY=replace-in-dokploy-only
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL_CONFIG_SOURCE=/app/config/model-routes.json
AI_MODEL_CONFIG_REFRESH_SECONDS=30

# Internal service URLs
AI_SERVICE_URL=http://ai-service:8000
EVIDENCE_SERVICE_URL=http://evidence-service:8000
COMPLIANCE_SERVICE_URL=http://compliance-service:8000
SUPPORT_SERVICE_URL=http://support-service:8000
WORKER_SERVICE_URL=http://worker-service:8000
